# Copie ce fichier en .env et remplis-le. Sans clé API, tout tourne en SIMULATION (rien n'est envoyé).

# --- IA (obligatoire) — console.anthropic.com ---
ANTHROPIC_API_KEY=
MODELE_RAPIDE=claude-haiku-5-5
MODELE_QUALITE=claude-sonnet-5-5
BUDGET_JOUR_EUR=2            # au-delà, les agents IA s'arrêtent jusqu'au lendemain
# SIMULATION=1               # force la simulation même avec une clé

# --- Email (obligatoire) — une adresse dédiée. Gmail : active la 2FA puis crée un « mot de passe d'application »
EMAIL_ADRESSE=
EMAIL_MOT_DE_PASSE=
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
IMAP_HOTE=imap.gmail.com

# --- Canal : telegram (conseillé) | whatsapp | console ---
CANAL=telegram
# WhatsApp : laisse vide pour le mode « Message à moi-même », ou ton numéro perso (ex. 32470123456)
# si le pont tourne sur un 2e numéro dédié à l'agent.
WHATSAPP_MON_NUMERO=
WHATSAPP_PONT_URL=http://127.0.0.1:3020
PORT_AGENT=3021
# Telegram : jeton donné par @BotFather (/newbot)
TELEGRAM_JETON=

# --- Vocaux : auto | local | openai | aucun ---
TRANSCRIPTION=auto
OPENAI_API_KEY=
WHISPER_MODELE=small

# --- Rythme (minutes) ---
INTERVALLE_VEILLE_MIN=30      # Student.be, StudentJob, Indeed, pages suivies (gratuit)
INTERVALLE_WEB_MIN=360        # recherche web par IA (≈0,10 € la recherche : 2-3 fois par jour suffit)
INTERVALLE_BOITE_MIN=5        # lecture des réponses
